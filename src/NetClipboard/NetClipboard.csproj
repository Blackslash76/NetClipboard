<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NetClipboard</RootNamespace>
    <AssemblyName>NetClipboard</AssemblyName>
    <Version>2.3.1</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>NetClipboard</Product>
    <Description>Clipboard condivisa peer-to-peer sulla LAN</Description>
    <ApplicationIcon>appicon.ico</ApplicationIcon>

    <!-- Metadati completi nella risorsa di versione dell'eseguibile. Un binario
         non firmato e privo di dati sull'autore e' uno dei segnali che fanno
         alzare il punteggio alle euristiche antivirus al momento del download. -->
    <Company>Francesco Papeo</Company>
    <Authors>Francesco Papeo</Authors>
    <Copyright>Copyright (c) 2026 Francesco Papeo</Copyright>
    <AssemblyTitle>NetClipboard</AssemblyTitle>
    <NeutralLanguage>it-IT</NeutralLanguage>
    <PackageProjectUrl>https://github.com/Blackslash76/NetClipboard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Blackslash76/NetClipboard</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="appicon.ico" />
    <!-- Cataloghi delle lingue: incorporati nell'exe (niente assembly satellite,
         che complicherebbero il publish single-file). Aggiungere una lingua =
         aggiungere Resources/xx.json, senza toccare il csproj. -->
    <EmbeddedResource Include="Resources\*.json" LogicalName="NetClipboard.Resources.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.87.0" />
    <PackageReference Include="Microsoft.Identity.Client.Broker" Version="4.87.0" />
  </ItemGroup>

</Project>
