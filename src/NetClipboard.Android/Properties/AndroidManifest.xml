<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

  <!-- Senza questo permesso il sistema scarta i pacchetti di broadcast prima che
       arrivino all'applicazione: si annuncerebbe agli altri senza sentire mai
       nessuno. E' anche il permesso che qualifica il servizio come
       "connectedDevice" (vedi NetClipboardService). -->
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <!-- android:allowBackup="false" non e' una noia burocratica: con il backup
       automatico acceso, Android copierebbe la cartella dell'applicazione su
       Google Drive, e li' dentro ci sono la chiave privata del dispositivo e
       l'elenco dei fidati. Una chiave che finisce in un backup di rete non e'
       piu' la chiave di UN dispositivo. -->
  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:fullBackupContent="false"
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:supportsRtl="true">

    <!-- Un'immagine negli appunti di Android non e' un blocco di byte: e' un
         content:// che punta a un file, e chi incolla lo legge da li'. Senza un
         provider, i nostri file sono in una cartella privata che nessun'altra
         applicazione puo' aprire, e "incolla" non troverebbe niente.

         grantUriPermissions: il permesso di lettura lo si concede caso per caso,
         a chi legge gli appunti, e scade da solo. Non e' una cartella aperta. -->
    <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.files"
        android:exported="false"
        android:grantUriPermissions="true">
      <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
    </provider>

  </application>

</manifest>
