<?xml version="1.0" encoding="utf-8"?>
<!-- Icona adattiva, e basta questa: l'applicazione parte da Android 8 (API 26,
     vedi SupportedOSPlatformVersion) ed e' esattamente da li' che il sistema le
     capisce. Sotto servirebbero i PNG per ogni densita'; sopra, il sistema
     ritaglia da se' la forma giusta per ogni lanciatore. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@drawable/ic_launcher_background" />
  <foreground android:drawable="@drawable/ic_launcher_foreground" />
  <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
