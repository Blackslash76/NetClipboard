<Project Sdk="Microsoft.NET.Sdk">

  <!-- Banco di conformita' del protocollo: confronta cio' che il core produce
       oggi con i valori registrati in vectors.json.

       Gira su net10.0 puro, senza Windows: e' il banco che puo' essere eseguito
       ovunque giri il core — sul runner Linux della pipeline, e domani da
       un'implementazione che non sia in .NET. Esce con codice 1 se un valore non
       coincide. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>conformance</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetClipboard.Core\NetClipboard.Core.csproj" />
  </ItemGroup>

</Project>
