<Project Sdk="Microsoft.NET.Sdk">

  <!-- Strumento di sviluppo: prove di tenuta sui parser di rete e sul canale
       locale. Non fa parte del prodotto e non entra nella solution ne' nella
       pipeline di rilascio. Esce con codice 1 se un controllo fallisce, cosi'
       puo' fare da guardia. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>selftest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetClipboard\NetClipboard.csproj" />
  </ItemGroup>

</Project>
