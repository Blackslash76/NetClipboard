<Project Sdk="Microsoft.NET.Sdk">

  <!-- Banco di prova end-to-end: due (anzi nove) istanze del trasporto nello
       stesso processo, che si parlano davvero su loopback. Non fa parte del
       prodotto e non entra nella solution ne' nella pipeline di rilascio.
       Esce con codice 1 se un passo fallisce, cosi' puo' fare da guardia. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>e2e</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetClipboard\NetClipboard.csproj" />
  </ItemGroup>

</Project>
